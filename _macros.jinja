{#-
  Shared rendering macros. This file lives at the repository root, outside
  the _subdirectory ("template/"), so Copier never renders it into the
  output tree. It is NOT in _exclude — that would risk breaking Jinja's
  template loader, which must be able to resolve `{% from '_macros.jinja' %}`.

  Import from any template like:
      {% from '_macros.jinja' import cmd %}

  cmd(target) renders the user-facing command for a dev task. It resolves
  to `make <target>`, `just <target>`, or the raw underlying command,
  depending on the `task_runner` answer.

  When task_runner=none, only the four well-known targets (test, lint,
  fmt, verify) have a sensible mapping. Other targets like `test-all`
  intentionally have no fallback there — call sites should guard with
  `has_cmd(target)` before referencing them.
-#}
{%- macro cmd(target) -%}
{%- if task_runner == 'make' -%}
make {{ target }}
{%- elif task_runner == 'just' -%}
just {{ target }}
{%- else -%}
{%-   if target == 'test' -%}{{ test_command }}
{%-   elif target == 'lint' -%}{{ lint_command }}
{%-   elif target == 'fmt' -%}{{ fmt_command }}
{%-   elif target == 'verify' -%}{{ verify_command }}
{%-   else -%}
{#- Fail render loudly: an unsupported target under task_runner=none
    indicates a missing has_cmd() guard at the call site. Better to
    surface the bug at `copier copy/update` time than to ship a
    sentinel or empty string into the generated repo. The expression
    below interpolates the bad target into a missing attribute name,
    so Copier's StrictUndefined surfaces an error like `'dict object'
    has no attribute 'cmd_target_undefined_for_task_runner_none__<target>'`
    — naming the offending call site for the template author. -#}
{{- {} | attr('cmd_target_undefined_for_task_runner_none__' ~ target) -}}
{%-   endif -%}
{%- endif -%}
{%- endmacro -%}
{#-
  has_cmd(target) — emit a truthy string if cmd(target) renders something
  usable, otherwise emit an empty (falsy) string. Use at call sites as
  `{% if has_cmd('test-all') %} … {% endif %}` — Jinja treats any
  non-empty string as truthy.

  The known target sets mirror what the generated Makefile / justfile
  actually define and what `cmd()` handles for `task_runner=none`. Keep
  these tuples in sync if the runner files grow a new recipe.
-#}
{%- macro has_cmd(target) -%}
{%- if task_runner in ('make', 'just')
       and target in ('test', 'test-all', 'lint', 'fmt', 'verify', 'dev', 'clean') -%}yes
{%- elif task_runner == 'none'
       and target in ('test', 'lint', 'fmt', 'verify') -%}yes
{%- endif -%}
{%- endmacro -%}
{#-
  runner_file_name() — human label for the file that defines the tasks,
  used in prose like "fix the Makefile / justfile / underlying task definition".
-#}
{%- macro runner_file_name() -%}
{%- if task_runner == 'make' -%}Makefile
{%- elif task_runner == 'just' -%}justfile
{%- else -%}underlying task definition
{%- endif -%}
{%- endmacro -%}
{#-
  lang_glob() — the source-file glob for the chosen primary_language, used by
  any path-scoped rule that should fire on code (Copilot `applyTo:`,
  .claude/rules `paths:`). Single source of truth so the two consumers can't
  drift. Falls back to `**/*` for an unmapped language: a too-broad glob
  degrades gracefully, whereas a missing key would break the render.
-#}
{%- macro lang_glob() -%}
{%- set globs = {
  'python': '**/*.py',
  'typescript': '**/*.{ts,tsx}',
  'javascript': '**/*.{js,jsx,mjs,cjs}',
  'rust': '**/*.rs',
  'go': '**/*.go',
  'java': '**/*.java',
  'csharp': '**/*.cs',
  'cpp': '**/*.{c,cc,cpp,cxx,h,hh,hpp,cu,cuh}',
  'fortran': '**/*.{f,for,f90,f95,f03,f08,F,F90}',
  'julia': '**/*.jl',
  'other': '**/*'
} -%}
{{- globs.get(primary_language, '**/*') -}}
{%- endmacro -%}
{#-
  toolchain_bin_dir() — the directory the package manager's installer drops its
  binary into. Single source of truth for the install location, imported by both
  .agents/hooks/ensure-toolchain.sh.jinja and the .claude/settings.json Stop
  hook's `export PATH=...` so the two never drift. Empty for managers without a
  one-line installer (cmake/other), which don't generate the bootstrap script.
-#}
{%- macro toolchain_bin_dir() -%}
{%- if package_manager == 'uv' -%}$HOME/.local/bin
{%- elif package_manager == 'pixi' -%}$HOME/.pixi/bin
{%- endif -%}
{%- endmacro -%}
{#-
  toolchain_install_url() / toolchain_install_cmd() — the canonical installer
  URL and one-line install command for the package manager. Single source of
  truth, imported by both .agents/hooks/ensure-toolchain.sh.jinja (which runs it)
  and development/tool-bootstrap.md.jinja (which shows the manual fallback), so the two
  can't drift. Empty for managers without a one-line installer (cmake/other),
  which don't generate the bootstrap script.
-#}
{%- macro toolchain_install_url() -%}
{%- if package_manager == 'uv' -%}https://astral.sh/uv/install.sh
{%- elif package_manager == 'pixi' -%}https://pixi.sh/install.sh
{%- endif -%}
{%- endmacro -%}
{%- macro toolchain_install_cmd() -%}
{%- if package_manager == 'uv' -%}curl -LsSf https://astral.sh/uv/install.sh | sh
{%- elif package_manager == 'pixi' -%}curl -fsSL https://pixi.sh/install.sh | sh
{%- endif -%}
{%- endmacro -%}
