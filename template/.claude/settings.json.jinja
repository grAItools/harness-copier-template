{%- from '_macros.jinja' import cmd, toolchain_bin_dir with context -%}
{%- set bootstrap = package_manager in ['uv', 'pixi'] -%}
{%- set bin_dir = toolchain_bin_dir() -%}
{
  "permissions": {
    "allow": [
      {% if task_runner == 'make' -%}
      "Bash(make:*)",
      {% elif task_runner == 'just' -%}
      "Bash(just:*)",
      {% elif task_runner == 'none' -%}
      {{ ('Bash(' ~ verify_command ~ ')') | tojson }},
      {{ ('Bash(' ~ test_command ~ ')') | tojson }},
      {{ ('Bash(' ~ lint_command ~ ')') | tojson }},
      {{ ('Bash(' ~ fmt_command ~ ')') | tojson }},
      {% endif -%}
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    {#- Two entries, not `git push --force:*`: `:*` is a plain string-prefix
        match, so that single pattern also denied the safe, lease-checked
        `git push --force-with-lease` (issue #40). The exact form catches the
        bare command, the trailing-space prefix catches it with arguments,
        and neither is a prefix of `--force-with-lease`. -#}
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force :*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }{% if include_claude_hooks %},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {% if bootstrap -%}
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/ensure-toolchain.sh\" || true"
          },
          {% endif -%}
          {
            "type": "command",
            "command": "printf '{}' | sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/hook-input.sh\" .probe >/dev/null 2>&1 || { echo 'warning: the hook payload reader is not working - jq and python3 are both missing or unable to run, or .agents/hooks/hook-input.sh is damaged. The PreToolUse guard will deny every Bash call until this is fixed (apt-get install jq / brew install jq)' >&2; exit 1; }"
          },
          {# Guard self-test: run block-destructive.sh against a command on its
             own deny-list and expect the deny verdict. The PreToolUse [ -r ]
             check only proves the file is present - a guard truncated by an
             interrupted copier update or a symlink-less checkout runs and
             exits 0, silently allowing every destructive command (issue #41).
             A weakened guard fails the same probe. The verdict is exit 2 AND
             the guard's own deny message: dash also exits 2 when it cannot
             open or parse a script, and the message exists exactly to make a
             deny distinguishable from an infrastructure failure. Warn, don't
             block: exit 1 surfaces the message without ending the session. #}
          {
            "type": "command",
            "command": "G=\"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/block-destructive.sh\"; if [ -r \"$G\" ]; then err=$(printf '%s' 'rm -rf /' | sh \"$G\" 2>&1 >/dev/null); rc=$?; { [ \"$rc\" -eq 2 ] && printf '%s' \"$err\" | grep -q '^block-destructive: denied'; } || { echo \"warning: block-destructive.sh is present but failed its self-test - a deny-listed command was not denied (exit $rc, expected 2 with a deny message). The guard is damaged or weakened, so the PreToolUse hook will let destructive Bash commands through until .agents/hooks/block-destructive.sh is restored (git restore, or re-run copier update).\" >&2; exit 1; }; else echo 'warning: block-destructive.sh is missing or unreadable - the PreToolUse guard will deny every Bash call until .agents/hooks is restored.' >&2; exit 1; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/hook-input.sh\" .tool_input.file_path); rc=$?; [ \"$rc\" -eq 3 ] && { echo 'fmt skipped: no JSON parser on PATH (install jq: apt-get install jq / brew install jq)' >&2; exit 1; }; [ \"$rc\" -ne 0 ] && { echo \"fmt skipped: could not read the hook input (hook-input.sh exit $rc)\" >&2; exit 1; }; S=\"${CLAUDE_PROJECT_DIR:-.}/scripts/fmt-file.sh\"; [ -n \"$f\" ] && [ -x \"$S\" ] && \"$S\" \"$f\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks\"; [ -r \"$H/block-destructive.sh\" ] || { echo 'PreToolUse: block-destructive.sh is missing - denying Bash. Restore .agents/hooks, then retry.' >&2; exit 2; }; c=$(sh \"$H/hook-input.sh\" .tool_input.command); rc=$?; [ \"$rc\" -eq 3 ] && { echo 'PreToolUse: no working JSON parser on PATH, so the destructive-command guard cannot read the tool input - denying Bash. Install jq (apt-get install jq / brew install jq) from a shell outside the agent, then retry.' >&2; exit 2; }; [ \"$rc\" -ne 0 ] && { echo \"PreToolUse: could not read the tool input (hook-input.sh exit $rc; payload unreadable or .agents/hooks/hook-input.sh damaged) - denying Bash.\" >&2; exit 2; }; [ -n \"$c\" ] || { echo 'PreToolUse: no command found in the tool input - denying Bash.' >&2; exit 2; }; printf '%s' \"$c\" | sh \"$H/block-destructive.sh\""
          }
        ]
      }
    ],
    {% set stop_guard = "fail=2; flag=$(sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/hook-input.sh\" .stop_hook_active); rc=$?; if [ \"$rc\" -ne 0 ]; then if [ \"$rc\" -eq 3 ]; then why='no JSON parser on PATH; install jq (apt-get install jq / brew install jq)'; else why=\"hook-input.sh exit $rc\"; fi; echo \"verify: cannot read the stop-loop guard ($why) - running the gate anyway, but a red gate can only be reported, not blocked, until this is fixed.\" >&2; fail=1; fi; [ \"$flag\" = 'true' ] && exit 0; " -%}
    {# A hook's cwd is the session's, not necessarily the repo root, and the
       gate resolves its task file (Makefile / justfile / a raw command)
       against the cwd - so anchor it where the payload read already is, or
       the stop is blocked by "no makefile" instead of the code (issue #44). #}
    {% set gate_cd = "cd \"${CLAUDE_PROJECT_DIR:-.}\" && " -%}
    {# The gate's own failure output usually goes to stdout, which Claude Code
       does not surface on a non-blocking exit - so say it on stderr too when
       the stop is not being blocked, or the red result is invisible. #}
    {% set gate_tail = " || { [ \"$fail\" -eq 1 ] && echo 'verify: the gate FAILED and the stop was not blocked (unreadable stop-loop guard) - this session is unverified; re-run the gate yourself.' >&2; exit \"$fail\"; }" -%}
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            {% if bootstrap -%}
            "command": {{ ("export PATH=\"" ~ bin_dir ~ ":$PATH\"; " ~ stop_guard ~ "command -v " ~ package_manager ~ " >/dev/null 2>&1 || { echo 'verify skipped: " ~ package_manager ~ " unavailable (run .agents/hooks/ensure-toolchain.sh; see development/tool-bootstrap.md)' >&2; exit 1; }; " ~ gate_cd ~ cmd('verify') ~ gate_tail) | tojson }}
            {% else -%}
            "command": {{ (stop_guard ~ gate_cd ~ cmd('verify') ~ gate_tail) | tojson }}
            {% endif -%}
          }
        ]
      }
    ]
  }{% endif %}
}
