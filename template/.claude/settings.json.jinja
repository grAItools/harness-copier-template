{%- from '_macros.jinja' import cmd with context -%}
{%- set bootstrap = package_manager in ['uv', 'pixi'] -%}
{%- if package_manager == 'uv' -%}{%- set bin_dir = '$HOME/.local/bin' -%}
{%- elif package_manager == 'pixi' -%}{%- set bin_dir = '$HOME/.pixi/bin' -%}
{%- endif -%}
{
  "permissions": {
    "allow": [
      {% if task_runner == 'make' -%}
      "Bash(make:*)",
      {% elif task_runner == 'just' -%}
      "Bash(just:*)",
      {% elif task_runner == 'none' -%}
      {{ ('Bash(' ~ verify_command ~ ')') | tojson }},
      {{ ('Bash(' ~ test_command ~ ')') | tojson }},
      {{ ('Bash(' ~ lint_command ~ ')') | tojson }},
      {{ ('Bash(' ~ fmt_command ~ ')') | tojson }},
      {% endif -%}
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard origin:*)",
      "Bash(rm -rf:*)"
    ]
  }{% if include_claude_hooks %},
  "hooks": {
    {% if bootstrap -%}
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/ensure-toolchain.sh\""
          }
        ]
      }
    ],
    {% endif -%}
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -x scripts/fmt-file.sh && scripts/fmt-file.sh \"$CLAUDE_TOOL_INPUT_FILE_PATH\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$CLAUDE_TOOL_INPUT\" | sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/block-destructive.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            {% if bootstrap -%}
            "command": {{ ("INPUT=$(cat); [ \"$(printf '%s' \"$INPUT\" | jq -r '.stop_hook_active // false')\" = 'true' ] && exit 0; sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/ensure-toolchain.sh\" >&2 || true; export PATH=\"" ~ bin_dir ~ ":$PATH\"; command -v " ~ package_manager ~ " >/dev/null 2>&1 || { echo 'verify skipped: " ~ package_manager ~ " unavailable (see docs/tool-bootstrap.md)' >&2; exit 0; }; " ~ cmd('verify') ~ " || exit 2") | tojson }}
            {% else -%}
            "command": {{ ("INPUT=$(cat); [ \"$(printf '%s' \"$INPUT\" | jq -r '.stop_hook_active // false')\" = 'true' ] && exit 0; " ~ cmd('verify') ~ " || exit 2") | tojson }}
            {% endif -%}
          }
        ]
      }
    ]
  }{% endif %}
}
