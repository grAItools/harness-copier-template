{%- from '_macros.jinja' import cmd, toolchain_bin_dir with context -%}
{%- set bootstrap = package_manager in ['uv', 'pixi'] -%}
{%- set bin_dir = toolchain_bin_dir() -%}
{
  "permissions": {
    "allow": [
      {% if task_runner == 'make' -%}
      "Bash(make:*)",
      {% elif task_runner == 'just' -%}
      "Bash(just:*)",
      {% elif task_runner == 'none' -%}
      {{ ('Bash(' ~ verify_command ~ ')') | tojson }},
      {{ ('Bash(' ~ test_command ~ ')') | tojson }},
      {{ ('Bash(' ~ lint_command ~ ')') | tojson }},
      {{ ('Bash(' ~ fmt_command ~ ')') | tojson }},
      {% endif -%}
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)"
    ]
  }{% if include_claude_hooks %},
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {% if bootstrap -%}
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/ensure-toolchain.sh\" || true"
          },
          {% endif -%}
          {
            "type": "command",
            "command": "command -v jq >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1 || echo 'warning: neither jq nor python3 is on PATH - the PreToolUse guard will deny every Bash call until one is installed (apt-get install jq / brew install jq)' >&2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/hook-input.sh\" .tool_input.file_path) || { echo 'fmt skipped: cannot read the hook input (jq and python3 both missing; install jq)' >&2; exit 0; }; S=\"${CLAUDE_PROJECT_DIR:-.}/scripts/fmt-file.sh\"; [ -n \"$f\" ] && [ -x \"$S\" ] && \"$S\" \"$f\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks\"; [ -r \"$H/block-destructive.sh\" ] || { echo 'PreToolUse: block-destructive.sh is missing - denying Bash. Restore .agents/hooks, then retry.' >&2; exit 2; }; c=$(sh \"$H/hook-input.sh\" .tool_input.command) || { echo 'PreToolUse: cannot read the tool input (jq and python3 both missing), so the destructive-command guard cannot run - denying Bash. Install jq (apt-get install jq / brew install jq) from a shell outside the agent, then retry.' >&2; exit 2; }; [ -n \"$c\" ] || { echo 'PreToolUse: no command found in the tool input - denying Bash.' >&2; exit 2; }; printf '%s' \"$c\" | sh \"$H/block-destructive.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            {% if bootstrap -%}
            "command": {{ ("flag=$(sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/hook-input.sh\" .stop_hook_active) || { echo 'verify skipped: cannot read the hook input (jq and python3 both missing; install jq)' >&2; exit 0; }; [ \"$flag\" = 'true' ] && exit 0; export PATH=\"" ~ bin_dir ~ ":$PATH\"; command -v " ~ package_manager ~ " >/dev/null 2>&1 || { echo 'verify skipped: " ~ package_manager ~ " unavailable (run .agents/hooks/ensure-toolchain.sh; see development/tool-bootstrap.md)' >&2; exit 0; }; " ~ cmd('verify') ~ " || exit 2") | tojson }}
            {% else -%}
            "command": {{ ("flag=$(sh \"${CLAUDE_PROJECT_DIR:-.}/.agents/hooks/hook-input.sh\" .stop_hook_active) || { echo 'verify skipped: cannot read the hook input (jq and python3 both missing; install jq)' >&2; exit 0; }; [ \"$flag\" = 'true' ] && exit 0; " ~ cmd('verify') ~ " || exit 2") | tojson }}
            {% endif -%}
          }
        ]
      }
    ]
  }{% endif %}
}
